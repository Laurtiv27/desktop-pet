// 追加到用户层 ~/.dsh/dsh-pet/main-config.jsonc 的 pets 数组，不要替换默认女仆。
// autoBehavior: false = 只循环 idle；改为 true 后约每 5–9 秒走到随机点。
{
  "name": "方块英雄",
  "id": "blocky-hero",
  "size": 360,
  "balanceEnabled": false,
  "whisperEnabled": false,
  "workStatusEnabled": false,
  "fixedEnabled": true,
  "display": "desktop",
  "position": { "corner": "bottom-right", "marginX": 24, "marginY": 80 },
  "presentation": "model3d",
  "model3d": {
    "assetId": "blocky-hero",
    "meta": {
      "glb": "character.glb",
      "clips": {
        "idle": "idle",
        "walk": "walk",
        "run": "run",
        "jump": "jump",
        "wave": "wave",
        "happy": "cheer",
        "dance": "dance",
        "punch": "punch",
        "death": "death",
        "fall": "fall"
      },
      "walkSpeedPx": 120,
      "scale": 1,
      "pivot": { "x": 0, "y": 0, "z": 0 },
      "camera": { "kind": "perspective", "fov": 30, "distance": 4 },
      "facingMode": "mirror",
      "autoBehavior": false
    }
  }
}

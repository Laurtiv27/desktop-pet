{
  "name": "desktop-pet",
  "version": "0.4.7",
  "description": "独立运行的透明动画桌面宠物：多开、坐姿守护、屏幕感知与可选 AI 碎碎念/对话。",
  "icon": "assets/logo.png",
  "keywords": [
    "desktop-pet",
    "electron",
    "pet",
    "floating-widget"
  ],
  "homepage": "https://github.com/Laurtiv27/desktop-pet#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Laurtiv27/desktop-pet.git"
  },
  "bugs": {
    "url": "https://github.com/Laurtiv27/desktop-pet/issues"
  },
  "_comment": [
    "=============== desktop-pet 包清单说明 ===============",
    "type: module —— 本包是 ESM",
    "main / exports['.'] —— 宿主半侧入口 lib/index.js（standalone / Electron 应用内嵌）",
    "bin.desktop-pet —— 独立 CLI（lib/standalone.js），不依赖外部宿主",
    "files —— npm publish 白名单（素材、runtime、脚本等）",
    "scripts.build —— node scripts/prepare.js；prepack 链式 typecheck/lint/检查",
    "engines —— Node.js >= 22.12",
    "================================================"
  ],
  "type": "module",
  "main": "lib/index.js",
  "bin": {
    "desktop-pet": "lib/standalone.js"
  },
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "assets/webm",
    "runtime/electron-helper",
    "assets/fonts",
    "assets/pic",
    "assets/memes",
    "assets/sound",
    "assets/model3d",
    "assets/posture",
    "assets/config.jsonc",
    "assets/logo.png",
    "assets/main-character.png",
    "scripts/ensure-electron.mjs",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "scripts": {
    "bundle": "tsdown",
    "build:desktop-core": "node scripts/build-desktop-core.mjs",
    "watch": "tsdown --watch",
    "ensure:electron": "node scripts/ensure-electron.mjs",
    "start:desktop": "node scripts/start-desktop.mjs",
    "standalone": "node lib/standalone.js",
    "start:app": "node scripts/start-app.mjs",
    "dist": "node scripts/dist.mjs",
    "dev:mock": "node scripts/dev/mock-server.mjs",
    "dev:subpath": "node scripts/dev/subpath-proxy.mjs",
    "vendor:posture": "node scripts/vendor-posture-assets.mjs",
    "vendor:three-model3d": "node scripts/vendor-three-model3d.mjs",
    "build": "node scripts/prepare.js",
    "prepack": "npm run build && npm run typecheck && npm run lint && npm run check:cycles && npm run check:runtime && npm run format:check && node scripts/prepack-check.js && npm run check:openapi",
    "check:openapi": "node scripts/check-openapi.mjs",
    "test": "node --experimental-strip-types --import ./scripts/test-register.mjs --test \"src/**/*.test.ts\"",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "types": "node scripts/gen-types.mjs",
    "lint": "eslint .",
    "check:cycles": "node scripts/check-import-cycles.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:ui": "node --test scripts/tests/*.test.mjs",
    "check:runtime": "eslint --config eslint.runtime.config.js runtime/electron-helper"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@andresaya/edge-tts": "^1.9.1",
    "@anthropic-ai/sdk": "0.135.0",
    "@electron-internal/extract-zip": "^1.0.5",
    "@electron/get": "^5.1.0",
    "@esotericsoftware/spine-webgl": "4.2",
    "@mediapipe/tasks-vision": "^1.2.2",
    "openai": "7.39.0",
    "three": "0.170.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.2.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.9.0",
    "eslint-plugin-jsdoc": "^65.4.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "js-yaml": "^5.4.2",
    "playwright": "1.63.0",
    "prettier": "^3.9.6",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "rolldown": "1.0.0-beta.7",
    "tsdown": "^0.8.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.67.0"
  }
}
